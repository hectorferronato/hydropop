-- Run manually in the Supabase SQL editor before enabling the physical-device
-- API. Generate a new independent value with `openssl rand -hex 32`, set the
-- same value as PHYSICAL_DEVICE_RPC_SECRET in Vercel, and never commit it.

select vault.create_secret(
  'REPLACE_WITH_THE_64_HEX_CHARACTER_PHYSICAL_DEVICE_RPC_SECRET',
  'hydropop_physical_device_rpc_secret',
  'Authenticates the HydroPOP Next.js physical-device boundary to its narrow database RPCs.'
);

-- Verify only safe metadata. Never select decrypted_secret during validation.
select name, created_at, updated_at
from vault.secrets
where name = 'hydropop_physical_device_rpc_secret';
