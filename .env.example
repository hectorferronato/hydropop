# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Application origin. Production: https://hydropop-lake.vercel.app
# Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only, comma-separated sign-in allowlist
ALLOWED_EMAILS=you@example.com,teammate@example.com

# Web Push. Generate a VAPID pair; keep the private key server-only.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
WEB_PUSH_SUBJECT=mailto:notifications@example.com

# Server-only 256-bit random value. Store the same value in Supabase Vault as
# `hydropop_push_worker_secret`; never prefix it with NEXT_PUBLIC_.
PUSH_WORKER_SECRET=replace-with-64-hex-character-random-secret

# Independent server-only 256-bit random value. Store the same value in
# Supabase Vault as `hydropop_physical_device_rpc_secret`. Hardware never gets
# this value; it receives only its dedicated device token.
PHYSICAL_DEVICE_RPC_SECRET=replace-with-another-64-hex-character-random-secret
